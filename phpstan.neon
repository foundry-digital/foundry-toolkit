# PHPStan at level max with the WordPress stubs and PHP 7.4 semantics.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: max
    phpVersion: 70400
    paths:
        - foundry-toolkit.php
        - includes
    scanFiles:
        - tests/phpstan-constants.php
        - tests/phpstan-cache-stubs.php
        - tests/phpstan-two-factor-stubs.php
    treatPhpDocTypesAsCertain: false
    # wp-config.php decides these per site; the stub values are only defaults.
    dynamicConstantNames:
        - FOUNDRY_ALLOW_XMLRPC
        - FOUNDRY_ALLOW_COMMENTS
        - FOUNDRY_ALLOW_FEEDS
        - FOUNDRY_ALLOW_APP_PASSWORDS
        - FOUNDRY_ALLOW_REGISTRATION
        - FOUNDRY_ALLOW_PLUGIN_INSTALLS
        - FOUNDRY_ALLOW_TOOLS
        - FOUNDRY_ALLOW_SETTINGS
        - FOUNDRY_ALLOW_ADMIN_CHANGES
        - FOUNDRY_ALLOW_LOGIN_WITHOUT_2FA
        - FOUNDRY_ALLOW_PRERELEASES
        # Defined by whichever copy loads first: ours or an old must-use agent.
        - SITEMANAGER_AGENT_VERSION
